typedef long int __off_t;
typedef struct _IO_FILE FILE;

extern FILE *stdin;
extern FILE *stdout;
extern FILE *stderr;

int main() {
    int x = 42;
    double y = 3.14;
    char *message = "Hello, World!";

    if (x > 0) {
        printf("Positive: %d\n", x@);
    } else {
        printf("Non-positive: %d\n", x);
    }

    for (int i = 0; i < 5; i++) {
        printf("Loop iteration: %d\n", i);
    }

    return 0;
}